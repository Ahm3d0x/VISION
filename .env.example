# =============================================================================
# VISION — Environment Configuration Template
# =============================================================================

# AI Provider Keys
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Local Ollama Inference (Optional)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Remote Gateway Server
VISION_GATEWAY_PORT=8765
VISION_GATEWAY_HOST=0.0.0.0
VISION_GATEWAY_SECRET=vision-super-secure-token

# Speech Services (services/config.py)
ASR_SERVICE_HOST=127.0.0.1
ASR_SERVICE_PORT=8765
TTS_SERVICE_HOST=127.0.0.1
TTS_SERVICE_PORT=8766
VISION_DEVICE=cuda:0
